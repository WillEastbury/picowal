"<!doctype html><html><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>PicoWAL Retail</title><script src=\"/baremetal/BareMetal.Communications.js\"></script><script src=\"/baremetal/BareMetal.Search.js\"></script><style>body{font-family:Segoe UI,Aptos,Calibri,sans-serif;margin:0;background:#111;color:#eee}.wrap{max-width:1180px;margin:auto;padding:24px}.hero{background:#1d1d1d;border:1px solid #333;border-radius:16px;padding:28px}.bar{display:flex;gap:8px;margin-top:18px}input{flex:1;padding:12px;border-radius:10px;border:1px solid #444;background:#181818;color:#fff}button{padding:12px 16px;border:0;border-radius:10px;background:#fd8ea1;color:#111;font-weight:700}.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(230px,1fr));gap:14px;margin-top:20px}.card{background:#1d1d1d;border:1px solid #333;border-radius:16px;padding:16px}.muted{color:#aaa}.tag{display:inline-block;background:#3a2028;color:#fd8ea1;border-radius:999px;padding:4px 8px;font-size:12px;margin-right:6px}.price{font-size:22px;font-weight:800}</style></head><body><div class=\"wrap\"><section class=\"hero\"><h1>PicoWAL Retail Search</h1><p class=\"muted\">Products, indexes, facets, journals and events are stored in PicoWAL. Search runs through PicoWAL Search and this page uses BareMetalJsTools transport/search modules.</p><div class=\"bar\"><input id=\"q\" value=\"waterproof jacket\"><button id=\"search\">Search</button><button id=\"seed\">Seed demo</button></div></section><div id=\"facets\" class=\"muted\"></div><section id=\"grid\" class=\"grid\"></section></div><script>var API='/api/retail/';BareMetal.Communications.setRoot(API);async function call(m,u,b){return BareMetal.Communications.call(m,u,b)}function esc(x){return String(x||'').replace(/[&<>\"']/g,function(c){return({'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;',\"'\":'&#39;'}[c])})}function render(items){grid.innerHTML=items.map(function(r){var p=r.product||r;return '<article class=\"card\"><div class=\"tag\">'+esc(p.category)+'</div><h3>'+esc(p.title)+'</h3><p class=\"muted\">'+esc(p.description)+'</p><p>'+esc(p.brand)+'</p><div class=\"price\">£'+Number(p.price||0).toFixed(2)+'</div><button data-id=\"'+esc(p.id)+'\">Recommend</button></article>'}).join('')}async function doSearch(){var r=await call('POST',API+'search',{query:q.value});render(r.results||[]);facets.textContent='Facets: '+JSON.stringify((r.facets||{}).category||[])}seed.onclick=async function(){await call('POST',API+'products:ingestDemo',{});await doSearch()};search.onclick=doSearch;grid.onclick=async function(e){if(e.target.dataset.id){var r=await call('POST',API+'recommend',{id:e.target.dataset.id});render(r.results||[])}};doSearch().catch(async function(){await call('POST',API+'products:ingestDemo',{});await doSearch()});</script></body></html>"
